{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Onesist",
  "version": "0.1.0",
  "identifier": "com.rogasper.onesist",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "pkill -9 -f 'onesist-server' 2>/dev/null; pkill -9 -f 'terminal-server.ts' 2>/dev/null; bun run dev",
    "beforeBuildCommand": "bun run build:server && bun scripts/prepare-resources.mjs"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' data: blob: http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/onesist-server"],
    "resources": ["web-dist", "vendor-skills"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NjQ2QjY3RTc3RkFBMzQKUldRMHFuL25aMnRrS05tZk5YcmtPN1U5Mk94TnRIN1REcC9nZzZHemtjcTNGRmdGQVMwaFBNNUMK",
      "endpoints": [
        "https://github.com/rogasper/onesist/releases/latest/download/manifest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
