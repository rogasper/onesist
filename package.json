{
  "name": "sa-dashboard",
  "version": "0.1.23",
  "description": "System Analyst Dashboard — ERD, API Spec, Wiki, FSD Analysis, Task Management",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.11"
  },
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run --bun vite build",
    "start": "bun run --bun vite",
    "build:server": "bun run --bun vite build && bun build src/server/terminal/terminal-server.ts --outdir dist/server/server --target bun --external node-pty && bun build src/server/terminal/terminal-server.ts --outfile dist/server/server/terminal-server.node.js --target node --external node-pty && bun scripts/post-build.mjs && bun scripts/build-server-bin.mjs && rm -f desktop-entry.ts",
    "generate:routes": "node scripts/generate-routes.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.8.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@dagrejs/dagre": "^3.0.0",
    "@dbml/core": "^8.3.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mdxeditor/editor": "^4.2.0",
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.167.65",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.12.0-beta.292",
    "@xterm/addon-web-links": "^0.13.0-beta.292",
    "@xterm/addon-webgl": "^0.20.0-beta.291",
    "@xterm/xterm": "^6.1.0-beta.292",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "mermaid": "^11.16.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swagger-ui-react": "^5.32.12",
    "ws": "^8.21.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.168.19",
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
